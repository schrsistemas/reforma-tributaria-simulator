{
  "schemaVersion": "1.0.0",
  "name": "reforma-tributaria-simulator-skills",
  "description": "Skill set modular para pesquisa, análise e operação fiscal brasileira.",
  "orchestrator": "tributario-orchestrator",
  "loadingContract": {
    "mode": "agent-skill-files",
    "entrypoint": "skills/tributario-orchestrator/SKILL.md",
    "moduleDirectory": "skills",
    "dispatch": "The API dispatcher resolves matched skills and transitive dependencies; the agent host loads each SKILL.md body before execution.",
    "runtimeIntegration": "Deterministic routing is implemented by workers/api at GET /api/v1/skills and POST /api/v1/skills/resolve. A host agent must still load instruction bodies and expose authorized tools.",
    "contextSchema": "skills/contracts/fiscal-context.schema.json",
    "resultSchema": "skills/contracts/skill-result.schema.json",
    "dispatcherEndpoints": {
      "catalog": "GET /api/v1/skills",
      "resolve": "POST /api/v1/skills/resolve",
      "authentication": "Integration token bound to X-Zynkronyx-Tenant"
    },
    "instructionBundle": "skills/instructions.json",
    "runtimePreparationEndpoint": "POST /api/v1/skills/prepare",
    "runtimePreparation": "Returns the selected Markdown instruction bodies, shared fiscal context, dependency order, source blob SHAs, and deduplicated tool names. It does not invoke an LLM or execute tools."
  },
  "principles": [
    "official-evidence-first",
    "publication-date-is-not-effective-date",
    "deterministic-calculation-only",
    "no-automatic-ruleset-publication",
    "declare-insufficient-evidence",
    "preserve-versioned-history"
  ],
  "skills": [
    {
      "id": "tributario-orchestrator",
      "path": "skills/tributario-orchestrator/SKILL.md",
      "role": "orchestrator",
