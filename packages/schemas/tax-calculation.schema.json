{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reforma-tributaria-simulator.schrsistemas.dev/schemas/tax-calculation.schema.json",
  "type": "object",
  "required": ["operationId", "calculationVersion", "taxes", "totalTax", "taxableBase", "ruleTrace"],
  "properties": {
    "operationId": {"type": "string"},
    "calculationVersion": {"type": "string"},
    "taxableBase": {"type": "string", "pattern": "^-?[0-9]+\\.[0-9]{2}$"},
    "totalTax": {"type": "string", "pattern": "^-?[0-9]+\\.[0-9]{2}$"},
    "taxes": {
      "type": "object",
      "required": ["IBS", "CBS"],
      "properties": {
        "IBS": {"$ref": "#/$defs/taxAmount"},
        "CBS": {"$ref": "#/$defs/taxAmount"}
      }
    },
    "ruleTrace": {"type": "array", "items": {"type": "object"}}
  },
  "$defs": {
    "taxAmount": {
      "type": "object",
      "required": ["base", "ratePercent", "amount"],
      "properties": {
        "base": {"type": "string"},
        "ratePercent": {"type": "string"},
        "amount": {"type": "string"}
      }
    }
  }
}
